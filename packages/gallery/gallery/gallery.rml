 Style" id="105:193"></LayoutComponentStyle><Fill name="Fill" id="0:141124"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:141125"/></Fill></LayoutComponent><LayoutComponent clip="true" width="0" height="0" styleId="105:198" name="CodeView" id="105:197"><LayoutComponentStyle flexDirectionValue="row" layoutWidthScaleType="fill" layoutHeightScaleType="hug" name="CodeView Style" id="105:198"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:196" name="CodeContent" id="105:195"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="hug" layoutHeightScaleType="hug" paddingTop="16" paddingRight="20" paddingBottom="18" paddingLeft="20" name="CodeContent Style" id="105:196"></LayoutComponentStyle><Text wrapValue="noWrap" sizingValue="autoWidth" name="Code" id="105:194"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout" id="0:141126"/><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:184"><Fill name="Fill" id="0:141127"><SolidColor colorValue="FFFFFFFF" name="Color" id="0:141128"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:185"><Fill name="Fill" id="0:141129"><SolidColor colorValue="99FFFFFF" name="Color" id="0:141130"/></Fill></TextStylePaint><TextValueRun styleId="105:184" text='import * as THREE from "../three/Three";&#10;' name="Run1" id="0:141131"></TextValueRun><TextValueRun styleId="105:184" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2" id="0:141132"></TextValueRun><TextValueRun styleId="105:184" text='import { Context } from "rive/host";&#10;' name="Run3" id="0:141133"></TextValueRun><TextValueRun styleId="105:184" text="&#10;" name="Run4" id="0:141134"></TextValueRun><TextValueRun styleId="105:185" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5" id="0:141135"></TextValueRun><TextValueRun styleId="105:184" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6" id="0:141136"></TextValueRun><TextValueRun styleId="105:184" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7" id="0:141137"></TextValueRun><TextValueRun styleId="105:184" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8" id="0:141138"></TextValueRun><TextValueRun styleId="105:184" text="    override setup(context: Context): bool {&#10;" name="Run9" id="0:141139"></TextValueRun><TextValueRun styleId="105:184" text="        this.scene.add(this.cube);&#10;" name="Run10" id="0:141140"></TextValueRun><TextValueRun styleId="105:184" text="        this.camera.position.z = 3;&#10;" name="Run11" id="0:141141"></TextValueRun><TextValueRun styleId="105:184" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12" id="0:141142"></TextValueRun><TextValueRun styleId="105:184" text="        return true;&#10;" name="Run13" id="0:141143"></TextValueRun><TextValueRun styleId="105:184" text="    }&#10;" name="Run14" id="0:141144"></TextValueRun><TextValueRun styleId="105:184" text="    override animate(seconds: f64): void {&#10;" name="Run15" id="0:141145"></TextValueRun><TextValueRun styleId="105:184" text="        this.cube.rotation.y += seconds;&#10;" name="Run16" id="0:141146"></TextValueRun><TextValueRun styleId="105:184" text="    }&#10;" name="Run17" id="0:141147"></TextValueRun><TextValueRun styleId="105:184" text="}" name="Run18" id="0:141148"></TextValueRun></Text><ScrollConstraint directionValue="horizontal" physicsId="105:183" name="Scroll" id="0:141149"/></LayoutComponent></LayoutComponent><Fill name="Fill" id="0:141150"><SolidColor colorValue="0DFFFFFF" name="Color" id="0:141151"/></Fill><Stroke thickness="1" name="Stroke" id="0:141152"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:141153"/></Stroke></LayoutComponent></LayoutComponent></La