d="0:3408842"/><TextStylePaint fontSize="11" letterSpacing="1.1" fontAssetId="106:3" familyName="IoskeleyMono" name="Style" id="105:189"><Fill name="Fill" id="0:3408843"><SolidColor colorValue="66FFFFFF" name="Color" id="0:3408844"/></Fill></TextStylePaint><TextValueRun styleId="105:189" text="ANIMASCRIPT" name="Run1" id="0:3408845"></TextValueRun></Text></LayoutComponent><LayoutComponent clip="false" width="0" height="1" styleId="105:194" name="Rule" id="105:193"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="fixed" name="Rule Style" id="105:194"></LayoutComponentStyle><Fill name="Fill" id="0:3408846"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:3408847"/></Fill></LayoutComponent><LayoutComponent clip="true" width="0" height="0" styleId="105:199" name="CodeView" id="105:198"><LayoutComponentStyle flexDirectionValue="row" layoutWidthScaleType="fill" layoutHeightScaleType="hug" name="CodeView Style" id="105:199"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:197" name="CodeContent" id="105:196"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="hug" layoutHeightScaleType="hug" paddingTop="16" paddingRight="20" paddingBottom="18" paddingLeft="20" name="CodeContent Style" id="105:197"></LayoutComponentStyle><Text wrapValue="noWrap" sizingValue="autoWidth" name="Code" id="105:195"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout" id="0:3408848"/><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:185"><Fill name="Fill" id="0:3408849"><SolidColor colorValue="FFFFFFFF" name="Color" id="0:3408850"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:186"><Fill name="Fill" id="0:3408851"><SolidColor colorValue="99FFFFFF" name="Color" id="0:3408852"/></Fill></TextStylePaint><TextValueRun styleId="105:185" text='import * as THREE from "../three/Three";&#10;' name="Run1" id="0:3408853"></TextValueRun><TextValueRun styleId="105:185" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2" id="0:3408854"></TextValueRun><TextValueRun styleId="105:185" text='import { Context } from "rive/host";&#10;' name="Run3" id="0:3408855"></TextValueRun><TextValueRun styleId="105:185" text="&#10;" name="Run4" id="0:3408856"></TextValueRun><TextValueRun styleId="105:186" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5" id="0:3408857"></TextValueRun><TextValueRun styleId="105:185" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6" id="0:3408858"></TextValueRun><TextValueRun styleId="105:185" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7" id="0:3408859"></TextValueRun><TextValueRun styleId="105:185" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8" id="0:3408860"></TextValueRun><TextValueRun styleId="105:185" text="    override setup(context: Context): bool {&#10;" name="Run9" id="0:3408861"></TextValueRun><TextValueRun styleId="105:185" text="        this.scene.add(this.cube);&#10;" name="Run10" id="0:3408862"></TextValueRun><TextValueRun styleId="105:185" text="        this.camera.position.z = 3;&#10;" name="Run11" id="0:3408863"></TextValueRun><TextValueRun styleId="105:185" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12" id="0:3408864"></TextValueRun><TextValueRun styleId="105:185" text="        return true;&#10;" name="Run13" id="0:3408865"></TextValueRun><TextValueRun styleId="105:185" text="    }&#10;" name="Run14" id="0:3408866"></TextValueRun><TextValueRun styleId="105:185" text="    override animate(seconds: f64): void {&#10;" name="Run15" id="0:3408867"></TextValueRun><TextValueRun styleId="105:185" text="        this.cube.rotation.y += seconds;&#10;" name="Run16" id="0:3408868"></TextValueRun><TextValueRun styleId="105:185" text="    }&#10;" name="Run17" id="0:3408869"></TextValueRun><TextValueRun styleId="105:185" text="}" name="Run18" id="0:3408870"></TextValueRun></Text><ScrollConstraint directionValue="horizontal" physicsId="105:184" name="Scroll" id="0:3408871"/></LayoutComponent></LayoutComponent><Fill name="Fill" id="0:3408872"><SolidColor colorValue="0DFFFFFF" name="Color" id="0:3408873"/></Fill><Stroke thickness="1" name="Stroke" id="0:3408874"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:3408875"/></Stroke></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent><LayoutComponent clip="false" width="0" height="0" styleId="105:285" name="Features" id="105:284"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="hug" paddingTop="96" paddingRight="24" paddingLeft="24" layoutAlignmentType="topCenter" name="Features Style" id="105:285"></LayoutComponentStyle><LayoutComponent clip="false" width="100" height="0" styleId="105:283" name="FeaturesInner" id="105:282"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fixed" widthUnitsValue="percent" layoutHeightScaleType="hug" gapHorizontal="40" gapVertical="40" maxWidth="1280" maxWidthUnitsValue="points" name="FeaturesInner Style" id="105:283"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:279" name="Header" id="105:278"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="hug" gapHorizontal="14" gapVertical="14" name="Header Style" id="105:279"></LayoutComponentStyle><Text wrapValue="wrap" name="Eyebrow" id="105:275"><LayoutParticipant layoutWidthScaleType="fill" layoutHeightScaleType="hug" name="Layout" id="0:3408876"/><TextStylePaint fontSize="12" letterSpacing="0.96" lineHeight="16" fontAssetId="106:2" familyName="Inter" name="Style" id="105:274"><Fill name="Fill" id="0:3