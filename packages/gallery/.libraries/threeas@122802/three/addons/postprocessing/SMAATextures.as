// The SMAA area and search textures of three.js's SMAAPass (generated by
// iryoku's AreaTex.py and SearchTex.py, https://github.com/iryoku/smaa),
// from the base64 PNGs in three.js r170's SMAAPass.js, unfiltered and
// stored as zlib-compressed raw texels, base64: decoding them stays
// within a script call's time budget (a PNG's scanline filters would
// not). Each is one literal: a chain of `+` is concatenated at startup,
// piece by piece (megabytes of garbage in every script's memory). Rows
// top first, as the PNGs. Written by a one-off script; the texels are
// three.js's, byte for byte.

import { unzlibSync } from "../libs/fflate";
import { DataTexture } from "../../textures/DataTexture";
import { LinearFilter, NearestFilter, RGFormat, RedFormat } from "../../constants";

export const SMAA_AREA_WIDTH: i32 = 160;
export const SMAA_AREA_HEIGHT: i32 = 560;
export const SMAA_SEARCH_WIDTH: i32 = 66;
export const SMAA_SEARCH_HEIGHT: i32 = 33;

/// The area texture: red and green, two bytes a texel (blue is 0).
export const SMAA_AREA_RG: string =
    "";

/// The search texture: one byte a texel.
export const SMAA_SEARCH_R: string =
    "eNpjYBgFo2AUjIJRQFvAyAhCMAqLIFQYSZbqJoz6glqAiQnsQCiFxRdMhHxBuQnDwxcAFsUAtQ==";

function base64Value(c: i32): i32 {
    if (c >= 65 && c <= 90) return c - 65;
    if (c >= 97 && c <= 122) return c - 71;
    if (c >= 48 && c <= 57) return c + 4;
    if (c == 43) return 62;
    if (c == 47) return 63;
    return -1;
}

function base64Decode(text: string): Uint8Array {
    const out = new Uint8Array(text.length * 3 / 4 + 3);
    let n = 0, acc: u32 = 0, bits = 0;
    for (let i = 0; i < text.length; i++) {
        const v = base64Value(text.charCodeAt(i));
        if (v < 0) continue;   // padding
        acc = (acc << 6) | <u32>v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            out[n++] = <u8>((acc >> <u32>bits) & 255);
        }
    }
    return out.slice(0, n);
}

/// A DataTexture of the zlib'd, base64 texels (`format`: RGFormat or
/// RedFormat), row 0 at v = 0 as three.js's flipY false; black when the
/// data does not inflate to the expected size.
function smaaTexture(base64: string, width: i32, height: i32, format: i32, channels: i32, linear: bool): DataTexture {
    const size = width * height * channels;
    let texels = unzlibSync(base64Decode(base64), size);
    if (texels.length != size) texels = new Uint8Array(size);
    const t = new DataTexture(texels, <u32>width, <u32>height, format);
    t.minFilter = linear ? LinearFilter : NearestFilter;
    t.magFilter = linear ? LinearFilter : NearestFilter;
    t.generateMipmaps = false;
    t.flipY = false;
    t.needsUpdate = true;
    return t;
}

/// The area texture (160 x 560, red and green), bilinear.
export function smaaAreaTexture(): DataTexture {
    return smaaTexture(SMAA_AREA_RG, SMAA_AREA_WIDTH, SMAA_AREA_HEIGHT, RGFormat, 2, true);
}

/// The search texture (66 x 33, red), nearest.
export function smaaSearchTexture(): DataTexture {
    return smaaTexture(SMAA_SEARCH_R, SMAA_SEARCH_WIDTH, SMAA_SEARCH_HEIGHT, RedFormat, 1, false);
}
