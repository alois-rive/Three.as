// Uniforms in insertion order.
struct Uniforms {
    turbidity: f32,
    rayleigh: f32,
    mieCoefficient: f32,
    mieDirectionalG: f32,
    sunPosition: vec3<f32>,
    up: vec3<f32>,
};
@group(2) @binding(0) var<uniform> u: Uniforms;

struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) vWorldPosition: vec3<f32>,
    @location(1) vSunDirection: vec3<f32>,
    @location(2) vSunfade: f32,
    @location(3) vBetaR: vec3<f32>,
    @location(4) vBetaM: vec3<f32>,
    @location(5) vSunE: f32,
};

// constants for atmospheric scattering
const e: f32 = 2.71828182845904523536028747135266249775724709369995957;
const pi: f32 = 3.141592653589793238462643383279502884197169;

// wavelength of used primaries, according to preetham
const lambda = vec3<f32>(680E-9, 550E-9, 450E-9);
// this pre-calcuation replaces older TotalRayleigh(vec3 lambda) function:
// (8.0 * pow(pi, 3.0) * pow(pow(n, 2.0) - 1.0, 2.0) * (6.0 + 3.0 * pn)) / (3.0 * N * pow(lambda, vec3(4.0)) * (6.0 - 7.0 * pn))
const totalRayleigh = vec3<f32>(5.804542996261093E-6, 1.3562911419845635E-5, 3.0265902468824876E-5);

// mie stuff
// K coefficient for the primaries
const v: f32 = 4.0;
const K = vec3<f32>(0.686, 0.678, 0.666);
// MieConst = pi * pow( ( 2.0 * pi ) / lambda, vec3( v - 2.0 ) ) * K
const MieConst = vec3<f32>(1.8399918514433978E14, 2.7798023919660528E14, 4.0790479543861094E14);

// earth shadow hack
// cutoffAngle = pi / 1.95;
const cutoffAngle: f32 = 1.6110731556870734;
const steepness: f32 = 1.5;
const EE: f32 = 1000.0;

fn sunIntensity(zenithAngleCos_in: f32) -> f32 {
    let zenithAngleCos = clamp(zenithAngleCos_in, -1.0, 1.0);
    return EE * max(0.0, 1.0 - pow(e, -((cutoffAngle - acos(zenithAngleCos)) / steepness)));
}

fn totalMie(T: f32) -> vec3<f32> {
    let c = (0.2 * T) * 10E-18;
    return 0.434 * c * MieConst;
}

@vertex
fn vs_main(@location(0) position: vec3<f32>) -> VsOut {
    var out: VsOut;
    let worldPosition = O.model * vec4<f32>(position, 1.0);
    out.vWorldPosition = worldPosition.xyz;

    out.clip = F.view_proj * worldPosition;
    out.clip.z = out.clip.w; // set z to camera.far

    out.vSunDirection = normalize(u.sunPosition);

    out.vSunE = sunIntensity(dot(out.vSunDirection, u.up));

    out.vSunfade = 1.0 - clamp(1.0 - exp((u.sunPosition.y / 450000.0)), 0.0, 1.0);

    let rayleighCoefficient = u.rayleigh - (1.0 * (1.0 - out.vSunfade));

    // extinction (absorbtion + out scattering)
    // rayleigh coefficients
    out.vBetaR = totalRayleigh * rayleighCoefficient;

    // mie coefficients
    out.vBetaM = totalMie(u.turbidity) * u.mieCoefficient;
    return out;
}

// constants for atmospheric scattering
const n: f32 = 1.0003; // refractive index of air
const N: f32 = 2.545E25; // number of molecules per unit volume for air at 288.15K and 1013mb (sea level -45 celsius)

// optical length at zenith for molecules
const rayleighZenithLength: f32 = 8.4E3;
const mieZenithLength: f32 = 1.25E3;
// 66 arc seconds -> degrees, and the cosine of that
const sunAngularDiameterCos: f32 = 0.999956676946448443553574619906976478926848692873900859324;

// 3.0 / ( 16.0 * pi )
const THREE_OVER_SIXTEENPI: f32 = 0.05968310365946075;
// 1.0 / ( 4.0 * pi )
const ONE_OVER_FOURPI: f32 = 0.07957747154594767;

fn rayleighPhase(cosTheta: f32) -> f32 {
    return THREE_OVER_SIXTEENPI * (1.0 + pow(cosTheta, 2.0));
}

fn hgPhase(cosTheta: f32, g: f32) -> f32 {
    let g2 = pow(g, 2.0);
    let inverse = 1.0 / pow(1.0 - 2.0 * g * cosTheta + g2, 1.5);
    return ONE_OVER_FOURPI * ((1.0 - g2) * inverse);
}

@fragment
fn fs_main(in: VsOut) -> @location(0) vec4<f32> {
    let direction = normalize(in.vWorldPosition - F.camera_pos.xyz);

    // optical length
    // cutoff angle at 90 to avoid singularity in next formula.
    let zenithAngle = acos(max(0.0, dot(u.up, direction)));
    let inverse = 1.0 / (cos(zenithAngle) + 0.15 * pow(93.885 - ((zenithAngle * 180.0) / pi), -1.253));
    let sR = rayleighZenithLength * inverse;
    let sM = mieZenithLength * inverse;

    // combined extinction factor
    let Fex = exp(-(in.vBetaR * sR + in.vBetaM * sM));

    // in scattering
    let cosTheta = dot(direction, in.vSunDirection);

    let rPhase = rayleighPhase(cosTheta * 0.5 + 0.5);
    let betaRTheta = in.vBetaR * rPhase;

    let mPhase = hgPhase(cosTheta, u.mieDirectionalG);
    let betaMTheta = in.vBetaM * mPhase;

    var Lin = pow(in.vSunE * ((betaRTheta + betaMTheta) / (in.vBetaR + in.vBetaM)) * (1.0 - Fex), vec3<f32>(1.5));
    Lin *= mix(vec3<f32>(1.0), pow(in.vSunE * ((betaRTheta + betaMTheta) / (in.vBetaR + in.vBetaM)) * Fex,
        vec3<f32>(1.0 / 2.0)), clamp(pow(1.0 - dot(u.up, in.vSunDirection), 5.0), 0.0, 1.0));

    // nightsky (three.js computes an unused uv here)
    var L0 = vec3<f32>(0.1) * Fex;

    // composition + solar disc
    let sundisk = smoothstep(sunAngularDiameterCos, sunAngularDiameterCos + 0.00002, cosTheta);
    L0 += (in.vSunE * 19000.0 * Fex) * sundisk;

    let texColor = (Lin + L0) * 0.04 + vec3<f32>(0.0, 0.0003, 0.00075);

    let retColor = pow(texColor, vec3<f32>(1.0 / (1.2 + (1.2 * in.vSunfade))));

    return three_output(retColor, 1.0, 0.0);
}
