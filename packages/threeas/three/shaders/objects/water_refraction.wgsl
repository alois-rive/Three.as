@group(0) @binding(0) var<uniform> F: FrameU;
@group(1) @binding(0) var<uniform> O: ObjU;

fn srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
    let lo = c * 0.0773993808;
    let hi = pow(c * 0.9478672986 + vec3<f32>(0.0521327014), vec3<f32>(2.4));
    return select(hi, lo, c < vec3<f32>(0.04045));
}

fn linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
    let x = max(c, vec3<f32>(0.0));
    let lo = x * 12.92;
    let hi = 1.055 * pow(x, vec3<f32>(0.41666)) - vec3<f32>(0.055);
    return select(hi, lo, x < vec3<f32>(0.0031308));
}

fn rrt_and_odt_fit(v: vec3<f32>) -> vec3<f32> {
    let a = v * (v + 0.0245786) - 0.000090537;
    let b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

fn agx_contrast(x: vec3<f32>) -> vec3<f32> {
    let x2 = x * x;
    let x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}

fn tone_map(color_in: vec3<f32>) -> vec3<f32> {
    let mode = u32(F.output.x);
    let exposure = F.output.y;
    var color = color_in;
    if (mode == TONE_LINEAR) {
        return saturate(exposure * color);
    } else if (mode == TONE_REINHARD) {
        color *= exposure;
        return saturate(color / (vec3<f32>(1.0) + color));
    } else if (mode == TONE_CINEON) {
        color *= exposure;
        color = max(vec3<f32>(0.0), color - 0.004);
        return pow((color * (6.2 * color + 0.5)) / (color * (6.2 * color + 1.7) + 0.06), vec3<f32>(2.2));
    } else if (mode == TONE_ACES) {
        let input = mat3x3<f32>(
            vec3<f32>(0.59719, 0.07600, 0.02840), vec3<f32>(0.35458, 0.90834, 0.13383),
            vec3<f32>(0.04823, 0.01566, 0.83777));
        let output = mat3x3<f32>(
            vec3<f32>(1.60475, -0.10208, -0.00327), vec3<f32>(-0.53108, 1.10813, -0.07276),
            vec3<f32>(-0.07367, -0.00605, 1.07602));
        color *= exposure / 0.6;
        color = output * rrt_and_odt_fit(input * color);
        return saturate(color);
    } else if (mode == TONE_AGX) {
        let to2020 = mat3x3<f32>(
            vec3<f32>(0.6274, 0.0691, 0.0164), vec3<f32>(0.3293, 0.9195, 0.0880), vec3<f32>(0.0433, 0.0113, 0.8956));
        let from2020 = mat3x3<f32>(
            vec3<f32>(1.6605, -0.1246, -0.0182), vec3<f32>(-0.5876, 1.1329, -0.1006), vec3<f32>(-0.0728, -0.0083, 1.1187));
        let inset = mat3x3<f32>(
            vec3<f32>(0.856627153315983, 0.137318972929847, 0.11189821299995),
            vec3<f32>(0.0951212405381588, 0.761241990602591, 0.0767994186031903),
            vec3<f32>(0.0482516061458583, 0.101439036467562, 0.811302368396859));
        let outset = mat3x3<f32>(
            vec3<f32>(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
            vec3<f32>(-0.11060664309660323, 1.157823702216272, -0.11060664309660294),
            vec3<f32>(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
        let min_ev = -12.47393;
        let max_ev = 4.026069;
        color *= exposure;
        color = inset * (to2020 * color);
        color = max(color, vec3<f32>(1e-10));
        color = clamp((log2(color) - min_ev) / (max_ev - min_ev), vec3<f32>(0.0), vec3<f32>(1.0));
        color = outset * agx_contrast(color);
        color = pow(max(vec3<f32>(0.0), color), vec3<f32>(2.2));
        return clamp(from2020 * color, vec3<f32>(0.0), vec3<f32>(1.0));
    } else if (mode == TONE_NEUTRAL) {
        let start = 0.8 - 0.04;
        let desaturation = 0.15;
        color *= exposure;
        let x = min(color.r, min(color.g, color.b));
        let offset = select(0.04, x - 6.25 * x * x, x < 0.08);
        color -= offset;
        let peak = max(color.r, max(color.g, color.b));
        if (peak < start) {
            return color;
        }
        let d = 1.0 - start;
        let new_peak = 1.0 - d * d / (peak + d - start);
        color *= new_peak / peak;
        let g = 1.0 - 1.0 / (desaturation * (peak - new_peak) + 1.0);
        return mix(color, vec3<f32>(new_peak), g);
    }
    return color;
}

/// The renderer's output: tone mapping (when the object is tone mapped and
/// the target is not HDR), fog at view depth `depth`, sRGB, premultiplied.
fn three_output(rgb_in: vec3<f32>, alpha: f32, depth: f32) -> vec4<f32> {
    var rgb = rgb_in;
    let linear_output = F.shadow_params.z > 0.5;
    if ((O.flags.y & FLAG_TONE_MAPPED) != 0u && !linear_output) {
        rgb = tone_map(rgb);
    }
    if ((O.flags.y & FLAG_FOG) != 0u && F.fog_color.w > 0.5) {
        var fog = 0.0;
        if (F.fog_color.w == FOG_LINEAR) {
            fog = smoothstep(F.fog_params.x, F.fog_params.y, depth);
        } else {
            let d = F.fog_params.z * depth;
            fog = 1.0 - exp(-d * d);
        }
        rgb = mix(rgb, F.fog_color.rgb, fog);
    }
    if (linear_output) {
        return vec4<f32>(rgb * alpha, alpha);
    }
    return vec4<f32>(linear_to_srgb(rgb) * alpha, alpha);
}
// @chunks-end

// Uniforms in insertion order: color, time, textureMatrix; then tDudv,
// tDiffuse.
struct Uniforms {
    color: vec3<f32>,
    time: f32,
    textureMatrix: mat4x4<f32>,
};
@group(2) @binding(0) var<uniform> u: Uniforms;
@group(2) @binding(1) var tDudv: texture_2d<f32>;
@group(2) @binding(2) var tDiffuse: texture_2d<f32>;
@group(2) @binding(3) var s_tex: sampler;

struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) vUv: vec2<f32>,
    @location(1) vUvRefraction: vec4<f32>,
};

@vertex
fn vs_main(@location(0) position: vec3<f32>, @location(2) uv: vec2<f32>) -> VsOut {
    var out: VsOut;
    out.vUv = uv;
    out.vUvRefraction = u.textureMatrix * vec4<f32>(position, 1.0);
    out.clip = F.view_proj * O.model * vec4<f32>(position, 1.0);
    return out;
}

fn blendOverlay(base: vec3<f32>, blend: vec3<f32>) -> vec3<f32> {
    return select(vec3<f32>(1.0) - 2.0 * (vec3<f32>(1.0) - base) * (vec3<f32>(1.0) - blend), 2.0 * base * blend,
        base < vec3<f32>(0.5));
}

fn dudv(uv: vec2<f32>) -> vec4<f32> {
    return textureSample(tDudv, s_tex, vec2<f32>(uv.x, 1.0 - uv.y));
}

@fragment
fn fs_main(in: VsOut) -> @location(0) vec4<f32> {
    let waveStrength = 0.5;
    let waveSpeed = 0.03;

    // simple distortion (ripple) via dudv map (see https://www.youtube.com/watch?v=6B7IF6GOu7s)
    var distortedUv = dudv(vec2<f32>(in.vUv.x + u.time * waveSpeed, in.vUv.y)).rg * waveStrength;
    distortedUv = in.vUv.xy + vec2<f32>(distortedUv.x, distortedUv.y + u.time * waveSpeed);
    let distortion = (dudv(distortedUv).rg * 2.0 - 1.0) * waveStrength;

    // new uv coords
    var uv = in.vUvRefraction;
    uv = vec4<f32>(uv.xy + distortion, uv.zw);

    // texture2DProj, clamped by hand (the sampler repeats, for the dudv map)
    let p = clamp(uv.xy / uv.w, vec2<f32>(0.0), vec2<f32>(1.0));
    let base = textureSample(tDiffuse, s_tex, vec2<f32>(p.x, 1.0 - p.y));

    return three_output(blendOverlay(base.rgb, u.color), 1.0, 0.0);
}
