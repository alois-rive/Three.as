int fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:181"><Fill name="Fill" id="0:131293"><SolidColor colorValue="FFFFFFFF" name="Color" id="0:131294"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:182"><Fill name="Fill" id="0:131295"><SolidColor colorValue="99FFFFFF" name="Color" id="0:131296"/></Fill></TextStylePaint><TextValueRun styleId="105:181" text='import * as THREE from "../three/Three";&#10;' name="Run1" id="0:131297"></TextValueRun><TextValueRun styleId="105:181" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2" id="0:131298"></TextValueRun><TextValueRun styleId="105:181" text='import { Context } from "rive/host";&#10;' name="Run3" id="0:131299"></TextValueRun><TextValueRun styleId="105:181" text="&#10;" name="Run4" id="0:131300"></TextValueRun><TextValueRun styleId="105:182" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5" id="0:131301"></TextValueRun><TextValueRun styleId="105:181" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6" id="0:131302"></TextValueRun><TextValueRun styleId="105:181" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7" id="0:131303"></TextValueRun><TextValueRun styleId="105:181" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8" id="0:131304"></TextValueRun><TextValueRun styleId="105:181" text="    override setup(context: Context): bool {&#10;" name="Run9" id="0:131305"></TextValueRun><TextValueRun styleId="105:181" text="        this.scene.add(this.cube);&#10;" name="Run10" id="0:131306"></TextValueRun><TextValueRun styleId="105:181" text="        this.camera.position.z = 3;&#10;" name="Run11" id="0:131307"></TextValueRun><TextValueRun styleId="105:181" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12" id="0:131308"></TextValueRun><TextValueRun styleId="105:181" text="        return true;&#10;" name="Run13" id="0:131309"></TextValueRun><TextValueRun styleId="105:181" text="    }&#10;" name="Run14" id="0:131310"></TextValueRun><TextValueRun styleId="105:181" text="    override animate(seconds: f64): void {&#10;" name="Run15" id="0:131311"></TextValueRun><TextValueRun styleId="105:181" text="        this.cube.rotation.y += seconds;&#10;" name="Run16" id="0:131312"></TextValueRun><TextValueRun styleId="105:181" text="    }&#10;" name="Run17" id="0:131313"></TextValueRun><TextValueRun styleId="105:181" text="}" name="Run18" id="0:131314"></TextValueRun></Text><ScrollConstraint directionValue="horizontal" physicsId="105:180" name="Scroll" id="0:131315"/></LayoutComponent></LayoutComponent><Fill name="Fill" id="0:131316"><SolidColor colorValue="0DFFFFFF" name="Color" id="0:131317"/></Fill><Stroke thickness="1" name="Stroke" id="0:131318"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:131319"/></Stroke></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent><LayoutComponent clip="false" width="0" height="0" styleId="105:281" name="Features" id="105:280"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="hug" paddingTop="96" paddingRight="24" paddingLeft="24" layoutAlignmentType="topCenter" name="Features Style" id="105:281"></LayoutComponentStyle><LayoutComponent clip="false" width="100" height="0" styleId="105:279" name="FeaturesInner" id="105:278"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fixed" widthUnitsValue="percent" layoutHeightScaleType="hug" gapHorizontal="40" gapVertical="40" maxWidth="1280" maxWidthUnitsValue="points" name="FeaturesInner Style" id="105:279"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:275" name="Header" id="105:274"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fil