youtParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout"/><TextStylePaint fontSize="11" letterSpacing="1.1" fontAssetId="106:3" familyName="IoskeleyMono" name="Style" id="105:184"><Fill name="Fill"><SolidColor colorValue="66FFFFFF" name="Color"/></Fill></TextStylePaint><TextValueRun styleId="105:184" text="ANIMASCRIPT" name="Run1"></TextValueRun></Text></LayoutComponent><LayoutComponent clip="false" width="0" height="1" styleId="105:189" name="Rule" id="105:188"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="fixed" name="Rule Style" id="105:189"></LayoutComponentStyle><Fill name="Fill"><SolidColor colorValue="1AFFFFFF" name="Color"/></Fill></LayoutComponent><LayoutComponent clip="true" width="0" height="0" styleId="105:194" name="CodeView" id="105:193"><LayoutComponentStyle flexDirectionValue="row" layoutWidthScaleType="fill" layoutHeightScaleType="hug" name="CodeView Style" id="105:194"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:192" name="CodeContent" id="105:191"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="hug" layoutHeightScaleType="hug" paddingTop="16" paddingRight="20" paddingBottom="18" paddingLeft="20" name="CodeContent Style" id="105:192"></LayoutComponentStyle><Text wrapValue="noWrap" sizingValue="autoWidth" name="Code" id="105:190"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout"/><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:180"><Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:181"><Fill name="Fill"><SolidColor colorValue="99FFFFFF" name="Color"/></Fill></TextStylePaint><TextValueRun styleId="105:180" text='import * as THREE from "../three/Three";&#10;' name="Run1"></TextValueRun><TextValueRun styleId="105:180" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2"></TextValueRun><TextValueRun styleId="105:180" text='import { Context } from "rive/host";&#10;' name="Run3"></TextValueRun><TextValueRun styleId="105:180" text="&#10;" name="Run4"></TextValueRun><TextValueRun styleId="105:181" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5"></TextValueRun><TextValueRun styleId="105:180" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6"></TextValueRun><TextValueRun styleId="105:180" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7"></TextValueRun><TextValueRun styleId="105:180" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8"></TextValueRun><TextValueRun styleId="105:180" text="    override setup(context: Context): bool {&#10;" name="Run9"></TextValueRun><TextValueRun styleId="105:180" text="        this.scene.add(this.cube);&#10;" name="Run10"></TextValueRun><TextValueRun styleId="105:180" text="        this.camera.position.z = 3;&#10;" name="Run11"></TextValueRun><TextValueRun styleId="105:180" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12"></TextValueRun><TextValueRun styleId="105:180" text="        return true;&#10;" name="Run13"></TextValueRun><TextValueRun styleId="105:180" text="    }&#10;" name="Run14"></TextValueRun><TextValueRun styleId="105:180" text="    override animate(seconds: f64): void {&#10;" name="Run15"></TextValueRun><TextValueRun styleId="105:180" text="        this.cube.rotation.y += seconds;&#10;" name="Run16"></TextValueRun><TextValueRun styleId="105:180" text="    }&#10;" name="Run17"></TextValueRun><TextValueRun styleId="105:180" text="}" name="Run18"></TextValueRun></Text><ScrollConstraint directionValue="horizontal" physicsId="105:179" name="Scroll"/></LayoutComponent></LayoutComponent><Fill name="F