        <Text x="584" y="12" originX="1" alignValue="right" name="Tag" id="105:78"><TextStylePaint fontSize="11" letterSpacing="1" fontAssetId="106:3" familyName="IoskeleyMono" name="Style" id="105:77"><Fill name="Fill"><SolidColor colorValue="FF5C5C5C" name="Color"><DataBindContext sourcePathIds="2:1-2:6" propertyKey="37"/></SolidColor></Fill></TextStylePaint><TextValueRun styleId="105:77" text="ANIMASCRIPT" name="Run"/></Text>
        <Text x="20" y="18" wrapValue="noWrap" name="Code" id="105:79"><TextStylePaint fontSize="13" lineHeight="20" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:75"><Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"><DataBindContext sourcePathIds="2:1-2:3" propertyKey="37"/></SolidColor></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="20" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:76"><Fill name="Fill"><SolidColor colorValue="FFA0A0A0" name="Color"><DataBindContext sourcePathIds="2:1-2:5" propertyKey="37"/></SolidColor></Fill></TextStylePaint><TextValueRun styleId="105:75" text='import * as THREE from "../three/Three";&#10;' name="L1"/><TextValueRun styleId="105:75" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="L2"/><TextValueRun styleId="105:75" text='import { Context } from "rive/host";&#10;' name="L3"/><TextValueRun styleId="105:75" text="&#10;" name="L4"/><TextValueRun styleId="105:76" text="// attach it to a ScriptedLayout in your artboard&#10;" name="L5"/><TextValueRun styleId="105:75" text="export class Demo extends THREE.ThreeLayout {&#10;" name="L6"/><TextValueRun styleId="105:75" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="L7"/><TextValueRun styleId="105:75" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="L8"/><TextValueRun styleId="105:75" text="    override setup(context: Context): bool {&#10;" name="L9"/><TextValueRun styleId="105:75" text="        this.scene.add(this.cube);&#10;" name="L10"/><TextValueRun styleId="105:75" text="        this.camera.position.z = 3;&#10;" name="L11"/><TextValueRun styleId="105:75" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="L12"/><TextValueRun styleId="105:75" text="        return true;&#10;" name="L13"/><TextValueRun styleId="105:75" text="    }&#10;" name="L14"/><TextValueRun styleId="105:75" text="    override animate(seconds: f64): void {&#10;" name="L15"/><TextValueRun styleId="105:75" text="        this.cube.rotation.y += seconds;&#10;" name="L16"/><TextValueRun styleId="105:75" text="    }&#10;" name="L17"/><TextValueRun styleId="105:75" text="}" name="L18"/></Text>
        <Shape x="0" y="0" name="Panel"><Rectangle width="600" height="396" originX="0" originY="0" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF141414" name="Color"><DataBindContext sourcePathIds="2:1-2:4" propertyKey="37"/></SolidColor></Fill></Shape>
        </Node>
