5:193"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:191" name="CodeContent" id="105:190"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="hug" layoutHeightScaleType="hug" paddingTop="16" paddingRight="20" paddingBottom="18" paddingLeft="20" name="CodeContent Style" id="105:191"></LayoutComponentStyle><Text wrapValue="noWrap" sizingValue="autoWidth" name="Code" id="105:189"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout" id="0:115791"/><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:179"><Fill name="Fill" id="0:115792"><SolidColor colorValue="FFFFFFFF" name="Color" id="0:115793"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:180"><Fill name="Fill" id="0:115794"><SolidColor colorValue="99FFFFFF" name="Color" id="0:115795"/></Fill></TextStylePaint><TextValueRun styleId="105:179" text='import * as THREE from "../three/Three";&#10;' name="Run1" id="0:115796"></TextValueRun><TextValueRun styleId="105:179" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2" id="0:115797"></TextValueRun><TextValueRun styleId="105:179" text='import { Context } from "rive/host";&#10;' name="Run3" id="0:115798"></TextValueRun><TextValueRun styleId="105:179" text="&#10;" name="Run4" id="0:115799"></TextValueRun><TextValueRun styleId="105:180" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5" id="0:115800"></TextValueRun><TextValueRun styleId="105:179" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6" id="0:115801"></TextValueRun><TextValueRun styleId="105:179" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7" id="0:115802"></TextValueRun><TextValueRun styleId="105:179" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8" id="0:115803"></TextValueRun><TextValueRun styleId="105:179" text="    override setup(context: Context): bool {&#10;" name="Run9" id="0:115804"></TextValueRun><TextValueRun styleId="105:179" text="        this.scene.add(this.cube);&#10;" name="Run10" id="0:115805"></TextValueRun><TextValueRun styleId="105:179" text="        this.camera.position.z = 3;&#10;" name="Run11" id="0:115806"></TextValueRun><TextValueRun styleId="105:179" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12" id="0:115807"></TextValueRun><TextValueRun styleId="105:179" text="        return true;&#10;" name="Run13" id="0:115808"></TextValueRun><TextValueRun styleId="105:179" text="    }&#10;" name="Run14" id="0:115809"></TextValueRun><TextValueRun styleId="105:179" text="    override animate(seconds: f64): void {&#10;" name="Run15" id="0:115810"></TextValueRun><TextValueRun styleId="105:179" text="        this.cube.rotation.y += seconds;&#10;" name="Run16" id="0:115811"></TextValueRun><TextValueRun styleId="105:179" text="    }&#10;" name="Run17" id="0:115812"></TextValueRun><TextValueRun styleId="105:179" text="}" name="Run18" id="0:115813"></TextValueRun></Text><ScrollConstraint directionValue="horizontal" physicsId="105:178" name="Scroll" id="0:115814"/></LayoutComponent></LayoutComponent><Fill name="Fill" id="0:115815"><SolidColor colorValue="0DFFFFFF" name="Color" id="0:115816"/></Fill><Stroke thickness="1" name="Stroke" id="0:115817"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:115818"/></Stroke></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent></LayoutComponent><LayoutComponent clip="false" width="0" height="0" styleId="105:279" name="Features" id="105:278"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="hug" paddingTop="96" paddingRight="24" paddingLeft="24" layoutAlignmentType="topCenter" name="Features Style" id="105:279"></LayoutComponentSt