105:184"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout" id="0:3284"/><TextStylePaint fontSize="11" letterSpacing="1.1" fontAssetId="106:3" familyName="IoskeleyMono" name="Style" id="105:183"><Fill name="Fill" id="0:3285"><SolidColor colorValue="66FFFFFF" name="Color" id="0:3286"/></Fill></TextStylePaint><TextValueRun styleId="105:183" text="ANIMASCRIPT" name="Run1" id="0:3287"></TextValueRun></Text></LayoutComponent><LayoutComponent clip="false" width="0" height="1" styleId="105:188" name="Rule" id="105:187"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="fixed" name="Rule Style" id="105:188"></LayoutComponentStyle><Fill name="Fill" id="0:3288"><SolidColor colorValue="1AFFFFFF" name="Color" id="0:3289"/></Fill></LayoutComponent><LayoutComponent clip="true" width="0" height="0" styleId="105:193" name="CodeView" id="105:192"><LayoutComponentStyle flexDirectionValue="row" layoutWidthScaleType="fill" layoutHeightScaleType="hug" name="CodeView Style" id="105:193"></LayoutComponentStyle><LayoutComponent clip="false" width="0" height="0" styleId="105:191" name="CodeContent" id="105:190"><LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="hug" layoutHeightScaleType="hug" paddingTop="16" paddingRight="20" paddingBottom="18" paddingLeft="20" name="CodeContent Style" id="105:191"></LayoutComponentStyle><Text wrapValue="noWrap" sizingValue="autoWidth" name="Code" id="105:189"><LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Layout" id="0:3290"/><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Code" id="105:179"><Fill name="Fill" id="0:3291"><SolidColor colorValue="FFFFFFFF" name="Color" id="0:3292"/></Fill></TextStylePaint><TextStylePaint fontSize="13" lineHeight="21" fontAssetId="106:3" familyName="IoskeleyMono" name="Comment" id="105:180"><Fill name="Fill" id="0:3293"><SolidColor colorValue="99FFFFFF" name="Color" id="0:3294"/></Fill></TextStylePaint><TextValueRun styleId="105:179" text='import * as THREE from "../three/Three";&#10;' name="Run1" id="0:3295"></TextValueRun><TextValueRun styleId="105:179" text='import { OrbitControls } from "../three/addons/controls/OrbitControls";&#10;' name="Run2" id="0:3296"></TextValueRun><TextValueRun styleId="105:179" text='import { Context } from "rive/host";&#10;' name="Run3" id="0:3297"></TextValueRun><TextValueRun styleId="105:179" text="&#10;" name="Run4" id="0:3298"></TextValueRun><TextValueRun styleId="105:180" text="// attach it to a ScriptedLayout in your artboard&#10;" name="Run5" id="0:3299"></TextValueRun><TextValueRun styleId="105:179" text="export class Demo extends THREE.ThreeLayout {&#10;" name="Run6" id="0:3300"></TextValueRun><TextValueRun styleId="105:179" text="    cube: THREE.Mesh = new THREE.Mesh(&#10;" name="Run7" id="0:3301"></TextValueRun><TextValueRun styleId="105:179" text="        new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());&#10;" name="Run8" id="0:3302"></TextValueRun><TextValueRun styleId="105:179" text="    override setup(context: Context): bool {&#10;" name="Run9" id="0:3303"></TextValueRun><TextValueRun styleId="105:179" text="        this.scene.add(this.cube);&#10;" name="Run10" id="0:3304"></TextValueRun><TextValueRun styleId="105:179" text="        this.camera.position.z = 3;&#10;" name="Run11" id="0:3305"></TextValueRun><TextValueRun styleId="105:179" text="        this.controls = new OrbitControls(this.camera, this.renderer);&#10;" name="Run12" id="0:3306"></TextValueRun><TextValueRun styleId="105:179" text="        return true;&#10;" name="Run13" id="0:3307"></TextValueRun><TextValueRun styleId="105:179" text="    }&#10;" name="Run14" id="0:3308"></TextValueRun><TextValueRun styleId="105:179" text="    override animate(seconds: f64): void {&#10;" name="Run15" id="0:3309"></TextValueRun><TextValueRun styleId="105:179" text="        this.cube.rotation.y += sec