    <ScriptAsset file="examples/first_scene.as" name="first_scene" id="0:190"/>
    <ScriptAsset file="examples/hello_cube.as" name="hello_cube" id="0:191"/>
    <ScriptAsset file="examples/geometries.as" name="geometries" id="0:192"/>
    <ScriptAsset file="examples/materials.as" name="materials" id="0:193"/>
    <ScriptAsset file="examples/primitives.as" name="primitives" id="0:194"/>
