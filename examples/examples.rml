    <Artboard isComponent="true" defaultStateMachineId="0:607" clip="true" x="1800" y="1400" width="800" height="600" styleId="0:601" name="Primitives" id="0:600">
        <LayoutComponentStyle name="Artboard Style" id="0:601"/>
        <LayoutComponent width="800" height="600" styleId="0:603" name="Root" id="0:602">
