                <ExitState x="120" y="-120" id="0:2651"/>
                <EntryState id="0:2652">
                    <StateTransition stateToId="0:292" id="0:2653"/>
                </EntryState>
                <AnimationState x="200" animationId="0:280" id="0:292"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="240" name="Spin" id="0:280">
            <KeyedObject objectId="0:210" id="0:2654">
                <KeyedProperty property="rotation" id="0:2655">
                    <KeyFrameDouble value="0" interpolationType="linear" id="0:2656"/>
                    <KeyFrameDouble value="6.2831855" interpolationType="linear" frame="240" id="0:2657"/>
