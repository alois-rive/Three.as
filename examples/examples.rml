<Rive version="1" kind="fragment">
    <!-- FirstScene: a ScriptedLayout running examples/first_scene.as, filling
         the artboard. Its `screen` input is the Screen artboard below, which
         the script draws onto the cube as a live texture. -->
    <Artboard defaultStateMachineId="0:107" clip="true" width="800" height="600" styleId="0:101" name="FirstScene" id="0:100">
        <Fill name="Background">
            <SolidColor colorValue="FF0E1116" name="Color"/>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:101"/>
        <LayoutComponent width="800" height="600" styleId="0:103" name="Root" id="0:102">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:103"/>
            <ScriptedLayout scriptAssetId="0:190" name="Scene" id="0:104">
                <ScriptInputArtboard artboardId="0:200" name="screen" id="0:105"/>
                <ScriptInputNumber propertyValue="1" name="speed" id="0:106"/>
            </ScriptedLayout>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:107">
            <StateMachineLayer name="Layer 1" id="0:108">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Screen: plain Rive content, animated by its own state machine. The
         scene shows it on every face of the cube. -->
    <Artboard defaultStateMachineId="0:290" x="900" width="512" height="512" styleId="0:201" name="Screen" id="0:200">
        <LayoutComponentStyle name="Screen Style" id="0:201"/>
        <Fill name="Background">
            <SolidColor colorValue="FF1B1F3B" name="Color"/>
        </Fill>
        <Shape x="256" y="256" name="Frame" id="0:202">
            <Rectangle width="464" height="464" originX="0.5" originY="0.5" linkCornerRadius="true" cornerRadiusTL="56" cornerRadiusTR="56" cornerRadiusBL="56" cornerRadiusBR="56" name="Path"/>
            <Stroke thickness="18" name="Stroke">
                <SolidColor colorValue="FFF4F1EA" name="Color"/>
            </Stroke>
        </Shape>
        <Node x="256" y="256" name="Spinner" id="0:210">
            <Shape x="0" y="-150" name="Dot1"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFFF5A5F" name="Color"/></Fill></Shape>
            <Shape x="129.9" y="-75" name="Dot2"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFFFB400" name="Color"/></Fill></Shape>
            <Shape x="129.9" y="75" name="Dot3"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF7AE582" name="Color"/></Fill></Shape>
            <Shape x="0" y="150" name="Dot4"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF2EC4B6" name="Color"/></Fill></Shape>
            <Shape x="-129.9" y="75" name="Dot5"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF4D9DE0" name="Color"/></Fill></Shape>
            <Shape x="-129.9" y="-75" name="Dot6"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFB388EB" name="Color"/></Fill></Shape>
        </Node>
        <Shape x="256" y="256" name="Core" id="0:220">
            <Triangle width="150" height="130" originX="0.5" originY="0.6" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFF4F1EA" name="Color"/>
            </Fill>
        </Shape>
        <StateMachine name="State Machine 1" id="0:290">
            <StateMachineLayer name="Layer 1" id="0:291">
                <EntryState>
                    <StateTransition stateToId="0:292"/>
                </EntryState>
                <AnimationState x="200" animationId="0:280" id="0:292"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="240" name="Spin" id="0:280">
            <KeyedObject objectId="0:210">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="6.2831855" interpolationType="linear" frame="240"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:220">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                    <KeyFrameDouble value="1.3" interpolationType="linear" frame="120"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="240"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                    <KeyFrameDouble value="1.3" interpolationType="linear" frame="120"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="240"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-6.2831855" interpolationType="linear" frame="240"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- HelloCube: three.js's "Creating a scene" tutorial, verbatim apart
         from types (examples/hello_cube.as). -->
    <Artboard defaultStateMachineId="0:307" clip="true" y="700" width="800" height="600" styleId="0:301" name="HelloCube" id="0:300">
        <LayoutComponentStyle name="Artboard Style" id="0:301"/>
        <LayoutComponent width="800" height="600" styleId="0:303" name="Root" id="0:302">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:303"/>
            <ScriptedLayout scriptAssetId="0:191" name="Scene" id="0:304"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:307">
            <StateMachineLayer name="Layer 1" id="0:308">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Geometries: every built-in geometry (examples/geometries.as). -->
    <Artboard defaultStateMachineId="0:407" clip="true" y="1400" width="800" height="600" styleId="0:401" name="Geometries" id="0:400">
        <LayoutComponentStyle name="Artboard Style" id="0:401"/>
        <LayoutComponent width="800" height="600" styleId="0:403" name="Root" id="0:402">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:403"/>
            <ScriptedLayout scriptAssetId="0:192" name="Scene" id="0:404"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:407">
            <StateMachineLayer name="Layer 1" id="0:408">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Materials: every mesh material, lights, fog, sky, tone mapping
         (examples/materials.as). -->
    <Artboard defaultStateMachineId="0:507" clip="true" x="900" y="1400" width="800" height="600" styleId="0:501" name="Materials" id="0:500">
        <LayoutComponentStyle name="Artboard Style" id="0:501"/>
        <LayoutComponent width="800" height="600" styleId="0:503" name="Root" id="0:502">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:503"/>
            <ScriptedLayout scriptAssetId="0:193" name="Scene" id="0:504"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:507">
            <StateMachineLayer name="Layer 1" id="0:508">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Primitives: instancing, points, lines, sprites, LOD
         (examples/primitives.as). -->
    <Artboard defaultStateMachineId="0:607" clip="true" x="1800" y="1400" width="800" height="600" styleId="0:601" name="Primitives" id="0:600">
        <LayoutComponentStyle name="Artboard Style" id="0:601"/>
        <LayoutComponent width="800" height="600" styleId="0:603" name="Root" id="0:602">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:603"/>
            <ScriptedLayout scriptAssetId="0:194" name="Scene" id="0:604"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:607">
            <StateMachineLayer name="Layer 1" id="0:608">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Shapes: curves, extrusion, tubes, and a Rive path extruded
         (examples/shapes.as). The Emblem artboard's StarPath is read by the
         script and extruded. -->
    <Artboard defaultStateMachineId="0:707" clip="true" x="2700" y="1400" width="800" height="600" styleId="0:701" name="Shapes" id="0:700">
        <LayoutComponentStyle name="Artboard Style" id="0:701"/>
        <LayoutComponent width="800" height="600" styleId="0:703" name="Root" id="0:702">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:703"/>
            <ScriptedLayout scriptAssetId="0:195" name="Scene" id="0:704">
                <ScriptInputArtboard artboardId="0:750" name="emblem" id="0:705"/>
            </ScriptedLayout>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:707">
            <StateMachineLayer name="Layer 1" id="0:708">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard x="3600" y="1400" width="200" height="200" styleId="0:751" name="Emblem" id="0:750">
        <LayoutComponentStyle name="Emblem Style" id="0:751"/>
        <Shape x="100" y="100" name="Star" id="0:752">
            <PointsPath isClosed="true" name="StarPath" id="0:753">
                <StraightVertex x="0.0" y="-90.0"/>
                <StraightVertex x="22.34" y="-30.74"/>
                <StraightVertex x="85.6" y="-27.81"/>
                <StraightVertex x="36.14" y="11.74"/>
                <StraightVertex x="52.9" y="72.81"/>
                <StraightVertex x="0.0" y="38.0"/>
                <StraightVertex x="-52.9" y="72.81"/>
                <StraightVertex x="-36.14" y="11.74"/>
                <StraightVertex x="-85.6" y="-27.81"/>
                <StraightVertex x="-22.34" y="-30.74"/>
            </PointsPath>
            <Fill name="Fill">
                <SolidColor colorValue="FFFFB400" name="Color"/>
            </Fill>
        </Shape>
    </Artboard>

    <!-- Interactive: a ThreeLayout with OrbitControls, a clickable Rive
         toggle on a panel, a RenderTarget "TV", hover highlights and a
         propeller driven by the Screen artboard's animated Spinner node
         (examples/interactive.as). -->
    <Artboard defaultStateMachineId="0:807" clip="true" y="2100" width="800" height="600" styleId="0:801" name="Interactive" id="0:800">
        <LayoutComponentStyle name="Artboard Style" id="0:801"/>
        <LayoutComponent width="800" height="600" styleId="0:803" name="Root" id="0:802">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:803"/>
            <ScriptedLayout scriptAssetId="0:196" name="Scene" id="0:804">
                <ScriptInputArtboard artboardId="0:850" name="toggle" id="0:805"/>
                <ScriptInputArtboard artboardId="0:200" name="screen" id="0:806"/>
            </ScriptedLayout>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:807">
            <StateMachineLayer name="Layer 1" id="0:808">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Toggle: a switch; clicking the track fires `flip`, which moves
         between the Off and On states. -->
    <Artboard defaultStateMachineId="0:870" x="900" y="2100" width="360" height="200" styleId="0:851" name="Toggle" id="0:850">
        <LayoutComponentStyle name="Toggle Style" id="0:851"/>
        <Fill name="Background">
            <SolidColor colorValue="FF1F2430" name="Color"/>
        </Fill>
        <!-- The first shape declared paints on top: the knob, then the track. -->
        <Shape x="125" y="100" name="Knob" id="0:854">
            <Ellipse width="86" height="86" originX="0.5" originY="0.5" name="KnobPath"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFF4F1EA" name="Color"/>
            </Fill>
        </Shape>
        <Shape x="180" y="100" name="Track" id="0:852">
            <Rectangle width="240" height="110" originX="0.5" originY="0.5" linkCornerRadius="true" cornerRadiusTL="55" cornerRadiusTR="55" cornerRadiusBL="55" cornerRadiusBR="55" name="TrackPath"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF5C6370" name="TrackColor" id="0:853"/>
            </Fill>
        </Shape>
        <StateMachine name="State Machine 1" id="0:870">
            <StateMachineTrigger name="flip" id="0:871"/>
            <StateMachineLayer name="Layer 1" id="0:872">
                <EntryState>
                    <StateTransition stateToId="0:873"/>
                </EntryState>
                <AnimationState x="200" animationId="0:860" id="0:873">
                    <StateTransition stateToId="0:874" duration="200">
                        <TransitionTriggerCondition inputId="0:871"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" animationId="0:861" id="0:874">
                    <StateTransition stateToId="0:873" duration="200">
                        <TransitionTriggerCondition inputId="0:871"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineListenerSingle targetId="0:852" listenerTypeValue="click" name="Flip">
                <ListenerTriggerChange inputId="0:871"/>
            </StateMachineListenerSingle>
        </StateMachine>
        <LinearAnimation duration="1" name="Off" id="0:860">
            <KeyedObject objectId="0:854">
                <KeyedProperty property="x">
                    <KeyFrameDouble value="125" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:853">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="FF5C6370" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="On" id="0:861">
            <KeyedObject objectId="0:854">
                <KeyedProperty property="x">
                    <KeyFrameDouble value="235" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:853">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="FF2EC4B6" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Deform: GPU skinning and morph targets (examples/deform.as). -->
    <Artboard defaultStateMachineId="0:907" clip="true" x="1800" y="2100" width="800" height="600" styleId="0:901" name="Deform" id="0:900">
        <LayoutComponentStyle name="Artboard Style" id="0:901"/>
        <LayoutComponent width="800" height="600" styleId="0:903" name="Root" id="0:902">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:903"/>
            <ScriptedLayout scriptAssetId="0:197" name="Scene" id="0:904"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:907">
            <StateMachineLayer name="Layer 1" id="0:908">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- Model: a glb loaded with GLTFLoader, animated (examples/model.as). -->
    <Artboard defaultStateMachineId="0:1007" clip="true" x="2700" y="2100" width="800" height="600" styleId="0:1001" name="Model" id="0:1000">
        <LayoutComponentStyle name="Artboard Style" id="0:1001"/>
        <LayoutComponent width="800" height="600" styleId="0:1003" name="Root" id="0:1002">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:1003"/>
            <ScriptedLayout scriptAssetId="0:198" name="Scene" id="0:1004"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:1007">
            <StateMachineLayer name="Layer 1" id="0:1008">
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <ScriptAsset file="examples/first_scene.as" name="first_scene" id="0:190"/>
    <ScriptAsset file="examples/hello_cube.as" name="hello_cube" id="0:191"/>
    <ScriptAsset file="examples/geometries.as" name="geometries" id="0:192"/>
    <ScriptAsset file="examples/materials.as" name="materials" id="0:193"/>
    <ScriptAsset file="examples/primitives.as" name="primitives" id="0:194"/>
