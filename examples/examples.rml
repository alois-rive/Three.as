                <AnimationState x="200" animationId="0:860" id="0:873">
                    <StateTransition stateToId="0:874" duration="200" id="0:2711">
                        <TransitionTriggerCondition inputId="0:871" id="0:2712"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" animationId="0:861" id="0:874">
                    <StateTransition stateToId="0:873" duration="200" id="0:2713">
                        <TransitionTriggerCondition inputId="0:871" id="0:2714"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineListenerSingle targetId="0:852" listenerTypeValue="click" name="Flip" id="0:2715">
                <ListenerTriggerChange inputId="0:871" id="0:2716"/>
            </StateMachineListenerSingle>
        </StateMachine>
        <LinearAnimation duration="1" name="Off" id="0:860">
