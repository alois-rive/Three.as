    <Artboard defaultStateMachineId="0:607" clip="true" x="1800" y="1400" width="800" height="600" styleId="0:601" name="Primitives" id="0:600">
        <LayoutComponentStyle name="Artboard Style" id="0:601"/>
        <LayoutComponent width="800" height="600" styleId="0:603" name="Root" id="0:602">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:603"/>
            <ScriptedLayout scriptAssetId="0:194" name="Scene" id="0:604"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:607">
