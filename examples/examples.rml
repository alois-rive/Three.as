            <Stroke thickness="18" name="Stroke" id="0:2621">
                <SolidColor colorValue="FFF4F1EA" name="Color" id="0:2622"/>
            </Stroke>
        </Shape>
        <Node x="256" y="256" name="Spinner" id="0:210">
            <Shape x="0" y="-150" name="Dot1" id="0:2623"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2624"/><Fill name="Fill" id="0:2625"><SolidColor colorValue="FFFF5A5F" name="Color" id="0:2626"/></Fill></Shape>
            <Shape x="129.9" y="-75" name="Dot2" id="0:2627"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2628"/><Fill name="Fill" id="0:2629"><SolidColor colorValue="FFFFB400" name="Color" id="0:2630"/></Fill></Shape>
            <Shape x="129.9" y="75" name="Dot3" id="0:2631"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2632"/><Fill name="Fill" id="0:2633"><SolidColor colorValue="FF7AE582" name="Color" id="0:2634"/></Fill></Shape>
            <Shape x="0" y="150" name="Dot4" id="0:2635"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2636"/><Fill name="Fill" id="0:2637"><SolidColor colorValue="FF2EC4B6" name="Color" id="0:2638"/></Fill></Shape>
            <Shape x="-129.9" y="75" name="Dot5" id="0:2639"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2640"/><Fill name="Fill" id="0:2641"><SolidColor colorValue="FF4D9DE0" name="Color" id="0:2642"/></Fill></Shape>
            <Shape x="-129.9" y="-75" name="Dot6" id="0:2643"><Ellipse width="72" height="72" originX="0.5" originY="0.5" name="Path" id="0:2644"/><Fill name="Fill" id="0:2645"><SolidColor colorValue="FFB388EB" name="Color" id="0:2646"/></Fill></Shape>
        </Node>
        <Shape x="256" y="256" name="Core" id="0:220">
