    <Artboard defaultStateMachineId="0:507" clip="true" x="900" y="1400" width="800" height="600" styleId="0:501" name="Materials" id="0:500">
        <LayoutComponentStyle name="Artboard Style" id="0:501"/>
        <LayoutComponent width="800" height="600" styleId="0:503" name="Root" id="0:502">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Root Style" id="0:503"/>
            <ScriptedLayout scriptAssetId="0:193" name="Scene" id="0:504"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:507">
